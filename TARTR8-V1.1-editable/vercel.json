{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build-public.js",
  "outputDirectory": "public",
  "redirects": [
    {
      "source": "/",
      "destination": "https://tartr8.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "destination": "https://tartr8.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
